; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="2dgame"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

AudioManager="*res://scripts/autoloads/audio_manager.gd"
LocalizationManager="*res://scripts/autoloads/localization_manager.gd"
CinematicManager="*res://scripts/autoloads/cinematic_manager.gd"
CameraManager="*res://scripts/autoloads/camera_manager.gd"
WeatherManager="*res://scripts/autoloads/weather_manager.gd"
GameState="*res://scripts/autoloads/game_state.gd"
StoryDataLoader="*res://scripts/autoloads/story_data_loader.gd"
QuestManager="*res://scripts/autoloads/quest_manager.gd"
CodexManager="*res://scripts/autoloads/codex_manager.gd"
SaveManager="*res://scripts/autoloads/save_manager.gd"
SceneTransition="*res://scenes/ui/scene_transition.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale=1.35

